---
import ProjectFilter, { type Project } from '../components/ProjectFilter';
import { FULL_NAME } from '../consts';
import Layout from '../layouts/Layout.astro';

const projects: Project[] = [
  {
    title: 'perfect-gpg-keypair',
    category: 'CLI tools',
    description:
      'Interactive Go CLI that generates a passphrase-protected RSA4096 master key, a separate signing subkey for commit signing, and a revocation certificate. Finally, the tool removes the master key from the machine once backed up.',
    image: '/images/perfect-gpg-keypair.svg',
    href: 'https://github.com/mariuswinger/perfect-gpg-keypair',
  },
];
---

<Layout title="Portfolio" description={`Selected projects of ${FULL_NAME}.`}>
  <h2 class="section-title">Portfolio</h2>
  <ProjectFilter projects={projects} client:visible />
</Layout>
