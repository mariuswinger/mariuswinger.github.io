---
import Icon from '../components/Icon.astro';
import { FULL_NAME } from '../consts';
import Layout from '../layouts/Layout.astro';

const email = 'hello@example.com';
const subject = encodeURIComponent('Hello from your website');
---

<Layout title="Contact" description={`Get in touch with ${FULL_NAME}`}>
  <h2 class="section-title">Contact</h2>

  <p class="max-w-prose text-muted leading-relaxed">
    Have a question, an idea, or just want to say hi? The easiest way to reach me is by the email in the sidebar. I
    usually reply within a couple of days. You can also reach out to me on the social links.
  </p>

</Layout>
