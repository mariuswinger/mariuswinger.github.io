---
import Timeline, { type TimelineItem } from '../components/Timeline.astro';
import { FULL_NAME } from '../consts';
import Layout from '../layouts/Layout.astro';

const experience: TimelineItem[] = [
  {
    title: 'Senior Systems Consultant — XLENT Trondheim',
    period: 'Nov 2026 — Present',
    description:
      'Consultant and fullstack developer with deep mathematical expertise and experience from professional software development for industrial environments.',
  },
  {
    title: 'Consultant — Bouvet Trondheim',
    period: 'Aug 2021 — Oct 2026',
    description:
      "Primarily on assignment at Equinor's research centre at Rotvoll as a fullstack developer with a backend focus. Development of applications for R&D, code modernisation and numerical computations.",
  },
  {
    title: 'PhD Candidate — NTNU, Department of Teacher Education',
    period: 'Jan 2017 — Jul 2021',
    description:
      'Research on fraction understanding among pre-service teachers. Combined literature review, existing theory and mathematical models to conceptualise and measure understanding. Completed the four-year fellowship; the thesis was not finished, and I moved into software development.',
  },
  {
    title: 'Temporary Assistant Professor — NTNU, Department of Teacher Education',
    period: 'Aug 2016 — Feb 2017',
    description: 'Taught introductory mathematics courses for pre-service teachers.',
  },
];

const education: TimelineItem[] = [
  {
    title: 'Bachelor studies in Informatics — NTNU',
    period: 'Aug 2015 — Jan 2017',
    description: 'Completed the first three semesters before switching to the PhD programme.',
  },
  {
    title: "Master's degree in Mathematical Sciences — NTNU",
    period: 'Aug 2013 — Jul 2015',
    description:
      'Wrote the master\'s thesis "A categorical approach to Cuntz–Pimsner C*-algebras", using category theory to give a new, simple proof of the gauge-invariant uniqueness theorem for Cuntz–Pimsner algebras. Supervised by Toke Meier Carlsen and Eduardo Ortega. Grade average A.',
  },
  {
    title: "Bachelor's degree in Mathematical Sciences — NTNU",
    period: 'Aug 2009 — Jul 2013',
    description:
      "Extended the bachelor's degree with an additional year of courses to help decide which master's programme specialisation to choose (240 ECTS in total).",
  },
];

const courses: TimelineItem[] = [
  {
    title: 'Advanced Machine Learning - Equinor',
    period: 'Mar 2025',
    description:
      'Neural networks with TensorFlow and PyTorch: backpropagation, gradient descent and tuning.',
  },
  {
    title: 'Machine Learning Fundamentals - Equinor',
    period: 'Mar 2025',
    description:
      'Classification with logistic regression, building a model from scratch in Python.',
  },
  {
    title: 'Applying DDD & EventStorming in Modern Architecture - Bouvet',
    period: 'Apr 2024',
    description:
      'Domain-Driven Design (DDD) and EventStorming for aligning architecture with business needs.',
  },
  {
    title: 'AZ-204: Developing Solutions for Microsoft Azure - Bouvet',
    period: 'Apr 2024',
    description:
      'Azure Developer Associate curriculum: compute, storage, security, integration and monitoring.',
  },
  {
    title: 'Implementing Modern Architecture - Bouvet',
    period: 'Jun 2023',
    description:
      'Microservices, CQRS, hexagonal architecture, event sourcing and common architecture pitfalls.',
  },
];

const skills: { level: string; items: string[] }[] = [
  {
    level: 'Daily drivers',
    items: [
      'Python',
      'FastAPI',
      'Docker',
      'Git',
      'GitHub',
      'GitHub Actions',
      'REST APIs',
      'TypeScript',
      'React',
      'NumPy',
    ],
  },
  {
    level: 'Comfortable with',
    items: [
      'Kubernetes',
      'Microsoft Azure',
      'MongoDB',
      'Numerical methods',
      'Cloud architecture',
      'Clean architecture',
      'Domain-driven design',
      'Software testing',
      'Agile development',
      'OAuth',
      'Dependency management',
      'Security scanning (GHAS)',
      'Linux',
      'Bash',
      'Lua',
      '.NET',
      'C#',
      'MATLAB',
      'AI agents',
      'AI-assisted development',
    ],
  },
  {
    level: 'Some experience',
    items: ['Go', 'Rust', 'Fortran', 'C++'],
  },
];
---

<Layout title="Resume" description={`Education, experience and skills of ${FULL_NAME}`}>
  <h2 class="section-title">Resume</h2>

  <div class="space-y-12">
    <Timeline heading="Experience" icon="briefcase" items={experience} />
    <Timeline heading="Education" icon="book" items={education} />
    <Timeline heading="Courses & Certifications" icon="certificate" items={courses} />

    <section aria-labelledby="skills">
      <h3 id="skills" class="subsection-title">My Skills</h3>
      <dl class="tile space-y-6">
        {
          skills.map((group) => (
            <div>
              <dt class="text-sm font-medium text-accent">{group.level}</dt>
              <dd class="mt-2 flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <span class="rounded-lg border border-border bg-surface px-3 py-1 text-sm">
                    {item}
                  </span>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>
</Layout>
