---
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import { FULL_NAME } from '../../consts';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Blog" description={`Blog entries by ${FULL_NAME}`}>
  <h2 class="section-title">Blog</h2>

  <ul class="grid gap-6 sm:grid-cols-2">
    {
      posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`} class="tile group block h-full">
            <p class="text-xs text-muted">
              <FormattedDate date={post.data.pubDate} />
              {post.data.tags.length > 0 && <span> · {post.data.tags.join(', ')}</span>}
            </p>
            <h3 class="mt-2 text-lg font-semibold group-hover:text-accent">{post.data.title}</h3>
            <p class="mt-2 text-sm text-muted leading-relaxed">{post.data.description}</p>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
