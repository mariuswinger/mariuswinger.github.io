---
import Icon, { type IconName } from '../components/Icon.astro';
import { FULL_NAME } from '../consts';
import Layout from '../layouts/Layout.astro';

const services: { title: string; description: string; icon: IconName }[] = [
  {
    title: 'Backend & APIs',
    description:
      'Designing and building REST APIs with FastAPI for large datasets and cloud infrastructure, with clean architecture and domain-driven design.',
    icon: 'server',
  },
  {
    title: 'Full-stack Development',
    description:
      'From backend services to frontend applications in TypeScript and React, including performance optimisation and modernisation of existing systems.',
    icon: 'code',
  },
  {
    title: 'R&D to Production',
    description:
      'Turning prototypes and mathematical models into robust, tested software where precision, performance, security and stability matter.',
    icon: 'bulb',
  },
  {
    title: 'Cloud & Delivery',
    description:
      'Docker, Kubernetes and Azure for deploying and orchestrating software, with testing of distributed systems and modern AI-assisted workflows.',
    icon: 'cog',
  },
];
---

<Layout title="About" description={`Personal website and portfolio of ${FULL_NAME}`}>
  <h2 class="section-title">About Me</h2>

  <div class="space-y-4 text-muted leading-relaxed">
    <p>
      I am a fullstack developer (heavy on the backend) with more than five years of industrial 
      experience in software development. I hold a master's degree in mathematics and have experience
      with doing academic research. I often work at the intersection of R&D, domain expertise and 
      software engineering, turning prototypes and models into robust applications where precision, 
      performance, security and stability are key.
    </p>
    <p>
      I have broad experience across backend and frontend problems, and can contribute with
      everything from performance optimisation and industrialising prototypes to API development
      and the accompanying frontend.
    </p>
    <p>
      I thrive on cross-disciplinary collaboration and sharing my knowledge. I also really enjoy
      exploring new domains, the more complex, the better. 
    </p>
  </div>

  <section class="mt-12" aria-labelledby="what-im-doing">
    <h3 id="what-im-doing" class="subsection-title">What I'm Doing</h3>
    <ul class="grid gap-5 sm:grid-cols-2">
      {
        services.map((s) => (
          <li class="tile flex gap-5">
            <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-surface text-accent">
              <Icon name={s.icon} class="size-6" />
            </span>
            <div>
              <h4 class="font-semibold">{s.title}</h4>
              <p class="mt-1 text-sm text-muted leading-relaxed">{s.description}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
