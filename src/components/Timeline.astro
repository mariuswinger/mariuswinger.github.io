---
import Icon, { type IconName } from './Icon.astro';

export type TimelineItem = {
  title: string;
  period: string;
  description: string;
};

interface Props {
  heading: string;
  icon: IconName;
  items: TimelineItem[];
}

const { heading, icon, items } = Astro.props;
const id = heading
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-|-$/g, '');
---

<section aria-labelledby={id}>
  <div class="mb-6 flex items-center gap-4">
    <span class="grid size-12 place-items-center rounded-xl bg-surface-2 text-accent">
      <Icon name={icon} class="size-5" />
    </span>
    <h3 id={id} class="text-xl font-semibold">{heading}</h3>
  </div>

  <ol class="ml-6 border-l border-border pl-8">
    {
      items.map((item) => (
        <li class="relative pb-8 last:pb-0">
          <span class="absolute -left-[2.3rem] top-1.5 size-2.5 rounded-full bg-accent ring-4 ring-surface" />
          <h4 class="font-semibold">{item.title}</h4>
          <p class="mt-1 text-sm text-accent">{item.period}</p>
          <p class="mt-2 text-sm text-muted leading-relaxed">{item.description}</p>
        </li>
      ))
    }
  </ol>
</section>
